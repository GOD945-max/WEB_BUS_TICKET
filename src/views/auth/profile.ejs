<%- include('../layouts/customer-header') %>
<!-- [TV1 - Nhóm 1: Tài khoản, xác thực và bảo mật] Giao diện Hồ sơ cá nhân & Đổi mật khẩu (Modern Minimalist) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
<style>
  :root {
    --mm-bg: #F8FAFC;
    --mm-surface: #FFFFFF;
    --mm-border: #E2E8F0;
    --mm-input-border: #CBD5E1;
    --mm-text: #0F172A;
    --mm-muted: #64748B;
    --mm-accent: #EA580C;
    --mm-accent-hover: #C2410C;
    --mm-accent-soft: #FFF7ED;
  }
  body {
    background-color: var(--mm-bg) !important;
    color: var(--mm-text);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .mm-card {
    background-color: var(--mm-surface);
    border: 1px solid var(--mm-border);
    border-radius: 16px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03);
  }
  .mm-eyebrow {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--mm-accent);
  }
  .mm-title {
    color: var(--mm-text);
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .mm-subtitle, .mm-hint {
    color: var(--mm-muted);
  }
  .mm-segmented {
    display: inline-flex;
    background-color: #F1F5F9;
    padding: 4px;
    border-radius: 10px;
    border: 1px solid var(--mm-border);
    gap: 4px;
  }
  .mm-segmented .nav-link {
    color: var(--mm-muted);
    background-color: transparent;
    border: 0;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.45rem 1rem;
    transition: all 0.15s ease;
  }
  .mm-segmented .nav-link:hover {
    color: var(--mm-text);
  }
  .mm-segmented .nav-link.active {
    background-color: #FFFFFF;
    color: var(--mm-text);
    font-weight: 600;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
  }
  .mm-avatar {
    width: 72px;
    height: 72px;
    border-radius: 999px;
    background-color: var(--mm-accent-soft);
    color: var(--mm-accent);
    border: 1px solid #FED7AA;
    font-size: 1.75rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .mm-pill {
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.72rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid transparent;
  }
  .mm-pill-danger { background-color: #FEE2E2 !important; color: #991B1B !important; border-color: #FECACA; }
  .mm-pill-warning { background-color: #FEF3C7 !important; color: #92400E !important; border-color: #FDE68A; }
  .mm-pill-info { background-color: #E0F2FE !important; color: #075985 !important; border-color: #BAE6FD; }
  .mm-pill-success { background-color: #DCFCE7 !important; color: #166534 !important; border-color: #BBF7D0; }
  .mm-pill-secondary { background-color: #F1F5F9 !important; color: #475569 !important; border-color: #E2E8F0; }
  .mm-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #334155;
    margin-bottom: 0.4rem;
  }
  .mm-input {
    border: 1px solid var(--mm-border);
    border-radius: 10px !important;
    padding: 0.65rem 0.9rem;
    font-size: 0.9375rem;
    color: var(--mm-text);
    background-color: #FFFFFF;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .mm-input:hover:not([readonly]):not(:disabled) {
    border-color: var(--mm-input-border);
  }
  .mm-input:focus {
    border-color: var(--mm-accent);
    box-shadow: 0 0 0 3px rgba(234, 88, 12, 0.12);
    outline: none;
  }
  .mm-input[readonly], .mm-input:disabled {
    background-color: #F8FAFC;
    color: var(--mm-muted);
    border-color: var(--mm-border);
  }
  .mm-password-group {
    border: 1px solid var(--mm-border);
    border-radius: 10px;
    background-color: #FFFFFF;
    overflow: hidden;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .mm-password-group:hover {
    border-color: var(--mm-input-border);
  }
  .mm-password-group:focus-within {
    border-color: var(--mm-accent);
    box-shadow: 0 0 0 3px rgba(234, 88, 12, 0.12);
  }
  .mm-password-group .form-control {
    border: 0;
    padding: 0.65rem 0.9rem;
    font-size: 0.9375rem;
    color: var(--mm-text);
    background: transparent;
  }
  .mm-password-group .form-control:focus {
    box-shadow: none;
  }
  .mm-password-group .toggle-password {
    border: 0;
    background: transparent;
    color: var(--mm-muted);
    padding: 0 0.9rem;
  }
  .mm-password-group .toggle-password:hover {
    color: var(--mm-text);
  }
  .btn-mm-primary {
    background-color: var(--mm-accent);
    border: 1px solid var(--mm-accent);
    color: #FFFFFF;
    border-radius: 10px;
    padding: 0.625rem 1.25rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .btn-mm-primary:hover, .btn-mm-primary:focus {
    background-color: var(--mm-accent-hover);
    border-color: var(--mm-accent-hover);
    color: #FFFFFF;
  }
  .btn-mm-dark {
    background-color: #0F172A;
    border: 1px solid #0F172A;
    color: #FFFFFF;
    border-radius: 10px;
    padding: 0.625rem 1.25rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .btn-mm-dark:hover, .btn-mm-dark:focus {
    background-color: #1E293B;
    border-color: #1E293B;
    color: #FFFFFF;
  }
  .btn-mm-outline {
    background-color: #FFFFFF;
    border: 1px solid var(--mm-border);
    color: #334155;
    border-radius: 10px;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .btn-mm-outline:hover {
    background-color: #F8FAFC;
    border-color: var(--mm-input-border);
    color: var(--mm-text);
  }
  .mm-alert {
    border: 1px solid var(--mm-border);
    border-left-width: 3px;
    border-radius: 10px;
    font-size: 0.85rem;
    padding: 0.75rem 1rem;
  }
  .mm-alert-danger {
    background-color: #FEF2F2;
    border-color: #FECACA;
    border-left-color: #DC2626;
    color: #991B1B;
  }
  .mm-alert-success {
    background-color: #ECFDF5;
    border-color: #A7F3D0;
    border-left-color: #16A34A;
    color: #166534;
  }
</style>

<%
  const rawErrors = (typeof errors !== 'undefined' && errors)
    ? (Array.isArray(errors) ? errors.filter(Boolean).join(' ') : String(errors))
    : null;
  const alertError = (typeof error !== 'undefined' && error)
    ? error
    : ((typeof errorMsg !== 'undefined' && errorMsg) ? errorMsg : rawErrors);
  const alertSuccess = (typeof success !== 'undefined' && success)
    ? success
    : ((typeof successMsg !== 'undefined' && successMsg) ? successMsg : null);

  const sessionCurrentUser = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : null;
  const p = (typeof profileUser !== 'undefined' && profileUser)
    ? profileUser
    : ((typeof user !== 'undefined' && user) ? user : (sessionCurrentUser || {}));

  const displayName = String(p.full_name || p.fullName || 'Quý hành khách').trim();
  const displayEmail = String(p.email || '').trim();
  const displayPhone = String(p.phone || '').trim();
  const role = String(p.role || 'customer').toLowerCase();
  const isVerified = p.is_verified === true || p.is_verified === 't' || p.is_verified === 'true' || p.isVerified === true;

  const nameParts = displayName.split(/\s+/).filter(Boolean);
  const avatarLetter = nameParts.length ? nameParts[nameParts.length - 1].charAt(0).toUpperCase() : 'K';

  const roleMap = {
    admin: { label: 'Quản trị viên', css: 'bg-danger mm-pill mm-pill-danger', icon: 'bi-shield-shaded' },
    staff: { label: 'Nhân viên nhà xe', css: 'bg-warning text-dark mm-pill mm-pill-warning', icon: 'bi-qr-code-scan' },
    customer: { label: 'Hành khách', css: 'bg-info text-dark mm-pill mm-pill-info', icon: 'bi-person-fill' }
  };
  const roleInfo = roleMap[role] || roleMap.customer;

  let joinedDate = '—';
  const createdRaw = p.created_at || p.createdAt;
  if (createdRaw) {
    const d = new Date(createdRaw);
    if (!isNaN(d.getTime())) {
      joinedDate = d.toLocaleDateString('vi-VN', {
        timeZone: 'Asia/Ho_Chi_Minh',
        day: '2-digit',
        month: '2-digit',
        year: 'numeric'
      });
    }
  }
%>

<main class="container py-5">
  <!-- Tiêu đề & Segmented Tabs -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
    <div>
      <div class="mm-eyebrow mb-1">TÀI KHOẢN CÁ NHÂN</div>
      <h1 class="h3 mm-title mb-1">Hồ sơ &amp; Bảo mật</h1>
      <p class="mm-subtitle mb-0 small">Quản lý thông tin liên hệ và mật khẩu đăng nhập hệ thống.</p>
    </div>

    <ul class="nav mm-segmented flex-nowrap overflow-auto">
      <li class="nav-item">
        <a class="nav-link active text-nowrap" aria-current="page" href="/auth/profile">
          Hồ sơ cá nhân
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link text-nowrap" href="/auth/booking-history">
          Lịch sử đặt vé
        </a>
      </li>
    </ul>
  </div>

  <!-- Thông báo lỗi / thành công -->
  <% if (alertError) { %>
    <div class="alert alert-danger alert-dismissible fade show mm-alert mm-alert-danger mb-4" role="alert">
      <span><%= alertError %></span>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
  <% } %>
  <% if (alertSuccess) { %>
    <div class="alert alert-success alert-dismissible fade show mm-alert mm-alert-success mb-4" role="alert">
      <span><%= alertSuccess %></span>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
  <% } %>

  <div class="row g-4">
    <!-- ===== CỘT 1: THẺ TÓM TẮT TÀI KHOẢN ===== -->
    <div class="col-12 col-lg-4">
      <div class="card mm-card h-100">
        <div class="card-body p-4 p-md-5 text-center">
          <div class="mm-avatar mb-3" aria-hidden="true">
            <%= avatarLetter %>
          </div>

          <h2 class="h5 mm-title mb-2"><%= displayName %></h2>
          <div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
            <span class="badge rounded-pill <%= roleInfo.css %>">
              <%= roleInfo.label %>
            </span>
            <% if (isVerified) { %>
              <span class="badge rounded-pill bg-success mm-pill mm-pill-success">
                Email đã xác thực
              </span>
            <% } else { %>
              <span class="badge rounded-pill bg-secondary mm-pill mm-pill-secondary">
                Email chưa xác thực
              </span>
            <% } %>
          </div>

          <div class="text-start small border-top pt-3" style="border-color: #F1F5F9 !important;">
            <div class="py-2 d-flex justify-content-between gap-2 border-bottom" style="border-color: #F1F5F9 !important;">
              <span class="mm-subtitle">Email</span>
              <span class="fw-medium text-end text-break" style="color: var(--mm-text);"><%= displayEmail || '—' %></span>
            </div>
            <div class="py-2 d-flex justify-content-between gap-2 border-bottom" style="border-color: #F1F5F9 !important;">
              <span class="mm-subtitle">Số điện thoại</span>
              <span class="fw-medium text-end" style="color: var(--mm-text);"><%= displayPhone || 'Chưa cập nhật' %></span>
            </div>
            <div class="py-2 d-flex justify-content-between gap-2">
              <span class="mm-subtitle">Ngày tham gia</span>
              <span class="fw-medium text-end" style="color: var(--mm-text);"><%= joinedDate %></span>
            </div>
          </div>

          <a href="/auth/booking-history" class="btn btn-mm-outline w-100 mt-4 py-2">
            Xem lịch sử đặt vé
          </a>
        </div>
      </div>
    </div>

    <!-- ===== CỘT 2: HAI BIỂU MẪU TÁCH BIỆT ===== -->
    <div class="col-12 col-lg-8">
      <!-- Card 1: Cập nhật Thông tin Cá nhân -->
      <div class="card mm-card mb-4">
        <div class="card-body p-4 p-md-5">
          <div class="mb-4">
            <h2 class="h5 mm-title mb-1">Thông tin cá nhân</h2>
            <p class="mm-subtitle small mb-0">Thông tin này được dùng để nhà xe liên hệ và đối chiếu khi lên xe.</p>
          </div>

          <form id="profileInfoForm" method="POST" action="/auth/profile">
            <input type="hidden" name="actionType" value="update_info">

            <div class="mb-3">
              <label for="profileEmail" class="form-label mm-label">Địa chỉ Email</label>
              <input type="email" class="form-control mm-input" id="profileEmail" value="<%= displayEmail %>" readonly disabled />
              <div class="form-text small mm-hint">Email đăng nhập không thể thay đổi.</div>
            </div>

            <div class="row g-3">
              <div class="col-12 col-md-6">
                <label for="fullName" class="form-label mm-label">
                  Họ và tên hành khách <span class="text-danger">*</span>
                </label>
                <input
                  type="text"
                  class="form-control mm-input"
                  id="fullName"
                  name="fullName"
                  required
                  minlength="2"
                  autocomplete="name"
                  placeholder="Ví dụ: Nguyễn Văn Khách"
                  value="<%= p.full_name || p.fullName || '' %>"
                />
              </div>

              <div class="col-12 col-md-6">
                <label for="phone" class="form-label mm-label">
                  Số điện thoại liên hệ <span class="text-danger">*</span>
                </label>
                <input
                  type="tel"
                  class="form-control mm-input"
                  id="phone"
                  name="phone"
                  required
                  pattern="^(0[35789][0-9]{8}|0[0-9]{9})$"
                  maxlength="10"
                  autocomplete="tel"
                  placeholder="0912345678"
                  title="Vui lòng nhập số điện thoại 10 chữ số hợp lệ (bắt đầu bằng số 0)"
                  value="<%= displayPhone %>"
                />
              </div>
            </div>

            <div class="d-flex justify-content-end mt-4">
              <button type="submit" class="btn btn-mm-primary">
                Lưu thông tin
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Card 2: Đổi Mật khẩu Bảo mật -->
      <div class="card mm-card">
        <div class="card-body p-4 p-md-5">
          <div class="mb-4">
            <h2 class="h5 mm-title mb-1">Đổi mật khẩu</h2>
            <p class="mm-subtitle small mb-0">Để bảo vệ tài khoản, vui lòng không chia sẻ mật khẩu cho bất kỳ ai.</p>
          </div>

          <form id="changePasswordForm" method="POST" action="/auth/profile">
            <input type="hidden" name="actionType" value="change_password">

            <div class="mb-3">
              <label for="currentPassword" class="form-label mm-label">
                Mật khẩu hiện tại <span class="text-danger">*</span>
              </label>
              <div class="input-group mm-password-group">
                <input type="password" class="form-control" id="currentPassword" name="currentPassword" required autocomplete="current-password" placeholder="Nhập mật khẩu đang sử dụng" />
                <button class="btn toggle-password" type="button" data-target="currentPassword" aria-label="Hiện hoặc ẩn mật khẩu hiện tại" title="Hiện/Ẩn mật khẩu">
                  <i class="bi bi-eye"></i>
                </button>
              </div>
            </div>

            <div class="row g-3">
              <div class="col-12 col-md-6">
                <label for="newPassword" class="form-label mm-label">
                  Mật khẩu mới <span class="text-danger">*</span>
                </label>
                <div class="input-group mm-password-group">
                  <input type="password" class="form-control" id="newPassword" name="newPassword" required minlength="6" autocomplete="new-password" placeholder="Tối thiểu 6 ký tự" />
                  <button class="btn toggle-password" type="button" data-target="newPassword" aria-label="Hiện hoặc ẩn mật khẩu mới" title="Hiện/Ẩn mật khẩu">
                    <i class="bi bi-eye"></i>
                  </button>
                </div>
              </div>

              <div class="col-12 col-md-6">
                <label for="confirmNewPassword" class="form-label mm-label">
                  Xác nhận mật khẩu mới <span class="text-danger">*</span>
                </label>
                <div class="input-group mm-password-group">
                  <input type="password" class="form-control" id="confirmNewPassword" name="confirmNewPassword" required minlength="6" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" />
                  <button class="btn toggle-password" type="button" data-target="confirmNewPassword" aria-label="Hiện hoặc ẩn mật khẩu xác nhận" title="Hiện/Ẩn mật khẩu">
                    <i class="bi bi-eye"></i>
                  </button>
                </div>
                <div id="confirmNewPasswordFeedback" class="form-text text-danger d-none small mt-1">
                  Mật khẩu xác nhận không khớp với mật khẩu mới.
                </div>
              </div>
            </div>

            <div class="d-flex justify-content-end mt-4">
              <button type="submit" class="btn btn-mm-dark">
                Đổi mật khẩu
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</main>

<script>
  (function () {
    document.querySelectorAll('.toggle-password').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var input = document.getElementById(btn.getAttribute('data-target'));
        var icon = btn.querySelector('i');
        if (!input) return;
        var show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        if (icon) {
          icon.classList.toggle('bi-eye', !show);
          icon.classList.toggle('bi-eye-slash', show);
        }
      });
    });

    var newPasswordInput = document.getElementById('newPassword');
    var confirmInput = document.getElementById('confirmNewPassword');
    var feedbackEl = document.getElementById('confirmNewPasswordFeedback');

    function validateMatch() {
      if (!newPasswordInput || !confirmInput) return;
      if (confirmInput.value && newPasswordInput.value !== confirmInput.value) {
        confirmInput.setCustomValidity('Mật khẩu xác nhận không khớp với mật khẩu mới.');
        if (feedbackEl) feedbackEl.classList.remove('d-none');
      } else {
        confirmInput.setCustomValidity('');
        if (feedbackEl) feedbackEl.classList.add('d-none');
      }
    }

    if (newPasswordInput && confirmInput) {
      newPasswordInput.addEventListener('input', validateMatch);
      confirmInput.addEventListener('input', validateMatch);
    }
  })();
</script>
<%- include('../layouts/customer-footer') %>
