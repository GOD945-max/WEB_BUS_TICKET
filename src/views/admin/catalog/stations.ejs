<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body class="bg-light"><nav class="navbar navbar-dark bg-primary px-3"><a class="navbar-brand" href="/admin/dashboard">Quản trị nhà xe</a><a class="text-white" href="/">Trang chủ</a></nav><div class="container-fluid"><div class="row"><aside class="col-md-3 col-lg-2 p-3 bg-white"><%- include('../../layouts/admin-layout', { navigationOnly: true }) %></aside><main class="col-md-9 col-lg-10 p-4"><h1 class="h4 mb-3"><%= title %></h1>
<% const defs = {stations:[['name','Tên bến'],['province','Tỉnh/thành'],['address','Địa chỉ'],['is_main_station','Bến chính','bool']],routes:[['name','Tên tuyến'],['origin_province','Điểm đi'],['destination_province','Điểm đến'],['distance_km','Khoảng cách (km)','number'],['duration_hours','Thời gian (giờ)','number'],['base_price','Giá cơ bản','number'],['description','Mô tả','text']], 'seat-layouts':[['name','Tên sơ đồ'],['total_seats','Tổng ghế','number'],['total_floors','Số tầng','number'],['rows_per_floor','Số hàng/tầng','number'],['cols_per_floor','Số cột/tầng','number']], buses:[['license_plate','Biển số'],['seat_layout_id','Sơ đồ ghế','layout'],['bus_type','Loại xe'],['amenities','Tiện ích'],['status','Trạng thái','status']], articles:[['title','Tiêu đề'],['slug','Slug (để trống để tạo tự động)'],['category','Chuyên mục','category'],['summary','Tóm tắt'],['content','Nội dung','textarea'],['thumbnail_url','Ảnh URL'],['is_published','Công khai','bool']] }; const fs=defs[kind]; %>
<div class="container-fluid px-0"><% if(error){ %><div class="alert alert-danger"><%= error %></div><% } if(success){ %><div class="alert alert-success"><%= success %></div><% } %>
<% const form = (item) => { %><form method="post" action="/admin/<%= kind %><%= item.id ? '/'+item.id : '' %>" class="row g-2 p-3 border rounded bg-white"><% fs.forEach(([name,label,type])=>{ const value=item[name] == null ? '' : item[name]; %><div class="col-md-6"><label class="form-label"><%= label %></label><% if(type==='bool'){ %><select class="form-select" name="<%= name %>"><option value="true" <%= value === true ? 'selected' : '' %>>Có</option><option value="false" <%= value === false ? 'selected' : '' %>>Không</option></select><% } else if(type==='layout'){ %><select class="form-select" name="<%= name %>" required><% layouts.forEach(l=>{ %><option value="<%= l.id %>" <%= String(value)===String(l.id)?'selected':'' %>><%= l.name %></option><% }) %></select><% } else if(type==='status' || type==='category'){ %><select class="form-select" name="<%= name %>"><% (type==='status'?['active','maintenance']:['news','promotion','policy','faq']).forEach(x=>{ %><option value="<%= x %>" <%= value===x?'selected':'' %>><%= x %></option><% }) %></select><% } else if(type==='textarea'){ %><textarea class="form-control" name="<%= name %>" required><%= value %></textarea><% } else { %><input class="form-control" type="<%= type==='number'?'number':'text' %>" <%= type==='number'?'step=any':'' %> name="<%= name %>" value="<%= value %>"><% } %></div><% }) %><div><button class="btn btn-primary">Lưu</button></div></form><% }; %>
<% if (kind === 'articles') { %><form method="get" class="d-flex gap-2 mb-3"><label for="category-filter" class="visually-hidden">Lọc chuyên mục</label><select id="category-filter" name="category" class="form-select"><option value="">Tất cả chuyên mục</option><% ['news','promotion','policy','faq'].forEach(c => { %><option value="<%= c %>" <%= category === c ? 'selected' : '' %>><%= c %></option><% }) %></select><button class="btn btn-outline-primary">Lọc</button></form><% } %>
<details class="mb-3"><summary class="btn btn-success">Thêm mới</summary><% form({}) %></details><div class="table-responsive"><table class="table table-bordered bg-white"><thead><tr><th>ID</th><% fs.forEach(([,label])=>{ %><th><%= label %></th><% }) %><th>Thao tác</th></tr></thead><tbody><% rows.forEach(item=>{ %><tr><td><%= item.id %></td><% fs.forEach(([name])=>{ %><td><%= String(item[name] ?? '') %></td><% }) %><td><details><summary>Sửa</summary><% form(item) %></details><% if(['stations','routes'].includes(kind)){ %><form method="post" action="/admin/<%= kind %>/<%= item.id %>/toggle"><button class="btn btn-outline-secondary btn-sm"><%= item.is_active ? 'Ngừng hoạt động' : 'Kích hoạt' %></button></form><% } if(['seat-layouts','articles'].includes(kind)){ %><form method="post" action="/admin/<%= kind %>/<%= item.id %>/delete"><button class="btn btn-outline-danger btn-sm">Xóa</button></form><% } if(kind==='buses' && item.has_upcoming_trip){ %><span class="text-danger">Xe có chuyến active sắp chạy: lưu ý trước khi bảo trì.</span><% } if(kind==='seat-layouts'){ %><div class="mt-2"><% const map = typeof item.seat_map_json === 'string' ? JSON.parse(item.seat_map_json) : item.seat_map_json; ['floor1','floor2'].forEach((floor,idx)=>{ if(map && Array.isArray(map[floor]) && map[floor].length){ %><strong>Tầng <%= idx+1 %></strong><div class="d-flex flex-wrap gap-1"><% map[floor].forEach(seat=>{ %><span class="badge text-bg-light border text-dark"><%= seat %></span><% }) %></div><% } }) %></div><% } %></td></tr><% }) %></tbody></table></div></div>
</main></div></div></body></html>
