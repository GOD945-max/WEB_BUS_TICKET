<%- include('../layouts/customer-header') %><main class="container py-4"><h1><%= title %></h1><% articles.forEach(a=>{ %><article class="card my-3 p-3"><h2 class="h5"><a href="/tin-tuc/<%= encodeURIComponent(a.slug) %>"><%= a.title %></a></h2><p><%= a.summary || '' %></p><% if(detail){ %><p style="white-space:pre-wrap"><%= a.content %></p><% } %></article><% }) %><% if(!articles.length){ %><p>Chưa có bài viết.</p><% } %></main><%- include('../layouts/customer-footer') %>